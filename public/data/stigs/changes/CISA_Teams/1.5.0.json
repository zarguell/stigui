              "value": "can "
            },
            {
              "count": 7,
              "added": false,
              "removed": true,
              "value": "be recorded by all participants by default"
            },
            {
              "count": 10,
              "added": true,
              "removed": false,
              "value": "pose data and video recording leakage and other security risks"
            },
            {
              "count": 23,
              "added": false,
              "removed": false,
              "value": ". Limiting recording permissions to only the organizer minimizes the security risk to the organizer's discretion for these Live Events. "
            },
            {
