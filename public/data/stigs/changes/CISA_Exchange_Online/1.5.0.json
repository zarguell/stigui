    {
      "outcome": "updated",
      "group_id": "V-A98F599F",
      "rule_id": "SV-A98F599Fr01017B",
      "rule_title": "Automatic forwarding to external domains SHALL be disabled.",
      "fieldDiffs": [
        {
          "field": "discussion",
          "parts": [
            {
              "count": 16,
              "added": false,
              "removed": false,
              "value": "Automatic forwarding to external domains SHALL be disabled.\n\nCriticality: SHALL.\nLast modified: "
            },
            {
              "count": 2,
              "added": false,
              "removed": true,
              "value": "June 2023"
            },
            {
              "count": 2,
              "added": true,
              "removed": false,
              "value": "March 2025"
            },
            {
              "count": 43,
              "added": false,
              "removed": false,
              "value": ".\n\nRationale: Adversaries can use automatic forwarding to gain persistent access to a victim's email. Disabling forwarding to external domains prevents this technique when the adversary is external to the organization but does not impede legitimate internal forwarding.\n\n"
            },
            {
              "count": 59,
              "added": true,
              "removed": false,
              "value": "Note: Automatic forwarding MAY be enabled with specific, agency-approved domains. There may be cases where an external domain is operationally needed and has an acceptable degree of risk, e.g., a domain controlled by the same agency that hasn't been added as an accepted domain in M365.\n\n"
            },
            {
              "count": 29,
              "added": false,
              "removed": false,
              "value": "MITRE ATT&CK: T1567: Exfiltration Over Web Service; T1048: Exfiltration Over Alternative Protocol; T1566: Phishing; T1566.001: Spearphishing Attachment"
            }
          ]
        },
        {
          "field": "fix_text",
          "parts": [
            {
              "count": 67,
              "added": false,
              "removed": false,
              "value": "To disallow automatic forwarding to external domains:\n1.  Sign in to the Exchange admin center.\n2.  Select Mail flow, then Remote domains.\n3.  Select Default.\n4.  Under Email reply types, select Edit reply types.\n5.  Clear the checkbox next to Allow automatic forwarding, then\nclick Save.\n6.  Return to Remote domains and "
            },
            {
              "count": 6,
              "added": false,
              "removed": true,
              "value": "repeat steps 4 and 5 for"
            },
            {
              "count": 1,
              "added": true,
              "removed": false,
              "value": "review"
            },
            {
              "count": 7,
              "added": false,
              "removed": false,
              "value": " each\nadditional remote domain in the list"
            },
            {
              "count": 11,
              "added": true,
              "removed": false,
              "value": ", ensuring that automatic forwarding\nis only allowed for approved domains"
            },
            {
              "count": 1,
              "added": false,
              "removed": false,
              "value": "."
            }
          ]
        }
      ]
    },
